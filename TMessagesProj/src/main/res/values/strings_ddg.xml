    <string name="DDGChatExportTitle">Chat export</string>
    <string name="DDGChatExportInfo">Pick a chat and DuckDuckGram writes its local history as Markdown: message text with formatting, authors, timestamps, and a table of attachments with names, sizes and whether the file is already on the device. Media files themselves are not copied, so the export never duplicates gigabytes out of the Telegram cache. The file goes to the ddg_export folder inside the app external files directory and is offered to share straight away. Only recent chats are listed</string>
    <string name="DDGChatExportHeader">Recent chats</string>
    <string name="DDGChatExportNoChats">No chats found</string>
    <string name="DDGChatExportBusy">An export is already running</string>
    <string name="DDGChatExportEmpty">This chat has no messages in the local database</string>
    <string name="DDGChatExportFailed">Export failed, see the log</string>
    <string name="DDGChatExportDone">%1$s: %2$d messages, %3$d attachments</string>
    <string name="DDGChatExportStamp">Exported: %1$s</string>
    <string name="DDGChatExportMessages">Messages: %1$d</string>
    <string name="DDGChatExportMediaItems">Media items: %1$d</string>
    <string name="DDGChatExportPeriod">Period: %1$s - %2$s</string>
    <string name="DDGChatExportTruncated">Only the first %1$d messages are included</string>
    <string name="DDGChatExportNoMedia">This chat has no attachments.</string>
    <string name="DDGChatExportMediaTitle">## Media (%1$d)</string>
    <string name="DDGChatExportTableHeader">| Time | From | Kind | File | Size | On device |\n| --- | --- | --- | --- | --- | --- |</string>
    <string name="DDGChatExportMediaNote">Files are not copied: only names, sizes and availability are listed. Telegram keeps downloaded files in its own folder; the export does not touch them.</string>
    <string name="DDGChatExportScopeNote">Not included: the media files themselves (see the table at the end) and any history that was not stored on this device. This file reflects the local database only.</string>

