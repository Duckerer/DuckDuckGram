    <string name="DDGHidePhotoCounterInfo">Hides the photo counter at the top of the viewer.</string>
    <string name="DDGDisableGifts">Hide gifts</string>
    <string name="DDGDisableGiftsInfo">Removes the gifts row from the profile, the gifts tab from the media section, and the gift counters.</string>
    <string name="DDGDisableAds">Hide ads</string>
    <string name="DDGDisableAdsInfo">Hides the promo banners Telegram sends to your account. Sponsored messages are already blocked by the app and are not affected by this setting.</string>
